CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

#disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

#enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Enable chip shell
CONFIG_ENABLE_CHIP_SHELL=y

CONFIG_ENABLE_WIFI_AP=n

#enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# disable softap by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
# unique local addresses for fabrics(MAX_FABRIC), a link local address(1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Increase max dynamic endpoint count to support 50 plug units (+ 1 root node + margin)
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=60

# Enable PSRAM
CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Use PSRAM for ESP-Matter data model
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y

# 4MB Flash (Standard)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Optimize for 50 endpoints (avoid timeouts during commissioning)
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=60
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Allow more time/resources for mDNS with many endpoints
CONFIG_ESP_MATTER_MDNS_MAX_ENDPOINTS=60

# Use PSRAM for ESP-Matter data model
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y

# Increase Event Loop Task Stack (important for many endpoints)
CONFIG_ESP_SYSTEM_EVENT_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# NimBLE optimizations
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3

